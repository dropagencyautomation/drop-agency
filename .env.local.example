# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# Uazapi
UAZAPI_BASE_URL=https://uazapi.seudominio.com
UAZAPI_TOKEN=...
UAZAPI_INSTANCE=drop-agency

# Redis (lock de atendimento humano + agrupamento de mensagens)
REDIS_URL=redis://default:senha@host:porta

# Janela (ms) que o webhook espera antes de a IA responder, agrupando as
# mensagens que o lead ainda estava digitando. Faixa aceita: 500..30000;
# valor invalido ou fora da faixa cai no padrao 6000 e loga o motivo.
# Trade-off: janela curta = resposta rapida, porem mais risco de a IA responder
# antes de o lead terminar e de gerar respostas duplicadas; janela longa =
# respostas mais coesas, porem ciclo lento.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEBHOOK_SECRET=gere-um-segredo-aleatorio

# Horário de atendimento (BRT)
# (removido) AGENT_HUMAN_LOCK_MINUTES e AGENT_DEBOUNCE_MS: as duas janelas do
# agente agora são editáveis na tela Agente IA do CRM (agent_settings), sem deploy.

# (removido) BUSINESS_HOURS_START/END: nunca foi lido pelo código. O horário de
# atendimento vive em agent_settings.business_hours, editável na tela Agente IA.
# Padrão hoje: 0-24, ou seja, a Carol responde 24 horas por dia, todos os dias.
